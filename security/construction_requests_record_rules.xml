<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
          Rules on one model are OR'd across the groups a user is in. So a
          requester sees their own, and anyone who reviews or approves sees all
          of them, and a manager - who is in all of those - sees all of them
          once rather than being restricted by the first rule.
        -->

        <record id="rule_request_own" model="ir.rule">
            <field name="name">Requests: own</field>
            <field name="model_id" ref="model_construction_request"/>
            <field name="domain_force">
                ['|', ('requested_by_id', '=', user.id),
                      ('employee_id.user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_request_user'))]"/>
        </record>

        <record id="rule_request_reviewer" model="ir.rule">
            <field name="name">Requests: reviewers see all</field>
            <field name="model_id" ref="model_construction_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('group_request_pe_review')),
                          (4, ref('group_request_hr_review')),
                          (4, ref('group_request_approver'))]"/>
        </record>

        <record id="rule_request_company" model="ir.rule">
            <field name="name">Requests: company</field>
            <field name="model_id" ref="model_construction_request"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False),
                      ('company_id', 'in', company_ids)]
            </field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_request_sequence_company" model="ir.rule">
            <field name="name">Request numbering: company</field>
            <field name="model_id" ref="model_construction_request_sequence"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False),
                      ('company_id', 'in', company_ids)]
            </field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
