<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Odoo 19 groups a company's roles under a res.groups.privilege rather than
      an ir.module.category directly, which is what puts them together as one
      block on the user form instead of scattering them.

      Each step of the review is a group, so "who may move this request on" is
      a setting on a person rather than a name compared inside a rule.
    -->

    <record id="res_groups_privilege_requests" model="res.groups.privilege">
        <field name="name">Requests</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_request_user" model="res.groups">
        <field name="name">Requester</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_requests"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Raises requests and follows their own.</field>
    </record>

    <record id="group_request_pe_review" model="res.groups">
        <field name="name">Project Engineer / Coordinator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_requests"/>
        <field name="implied_ids" eval="[(4, ref('group_request_user'))]"/>
        <field name="comment">Reviews the requests raised on their projects.</field>
    </record>

    <record id="group_request_hr_review" model="res.groups">
        <field name="name">HR Review</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_requests"/>
        <field name="implied_ids" eval="[(4, ref('group_request_user'))]"/>
        <field name="comment">Reviews leave, advance and certificate requests.</field>
    </record>

    <record id="group_request_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_requests"/>
        <field name="implied_ids" eval="[(4, ref('group_request_user'))]"/>
        <field name="comment">Gives the final approval.</field>
    </record>

    <record id="group_request_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_requests"/>
        <field name="implied_ids"
                eval="[(4, ref('group_request_pe_review')),
                       (4, ref('group_request_hr_review')),
                       (4, ref('group_request_approver'))]"/>
        <field name="comment">Sets up the request types and their numbering.</field>
    </record>

</odoo>
